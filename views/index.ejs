<!doctype html>
<html lang="ru" data-bs-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Projects Hub</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container py-4">
    <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
      <div>
        <h1 class="h3 mb-1">🗂 Projects Hub</h1>
        <div class="text-secondary small font-monospace"><%= root %></div>
      </div>
      <div>
        <a href="/" class="btn btn-outline-light btn-sm">↻ Обновить</a>
      </div>
    </header>

    <div class="row row-cols-2 row-cols-md-5 g-3 mb-4">
      <div class="col">
        <div class="card bg-body-tertiary h-100">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold"><%= summary.total %></div>
            <div class="text-secondary small">всего проектов</div>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card bg-body-tertiary h-100 border-success">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold text-success"><%= summary.gitWithRemote %></div>
            <div class="text-secondary small">git + remote</div>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card bg-body-tertiary h-100 border-warning">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold text-warning"><%= summary.gitNoRemote %></div>
            <div class="text-secondary small">git без remote</div>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card bg-body-tertiary h-100 border-danger">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold text-danger"><%= summary.noGit %></div>
            <div class="text-secondary small">без .git</div>
          </div>
        </div>
      </div>
      <div class="col">
        <div class="card bg-body-tertiary h-100 border-info">
          <div class="card-body text-center">
            <div class="fs-4 fw-bold text-info"><%= summary.uncommitted %></div>
            <div class="text-secondary small">незакоммичено</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <input
        type="text"
        id="filterInput"
        class="form-control"
        placeholder="Фильтр по имени проекта…"
        autocomplete="off"
      />
    </div>

    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle" id="projectsTable">
        <thead>
          <tr>
            <th>Проект</th>
            <th>Git</th>
            <th>Remotes</th>
            <th>Незакоммиченные изменения</th>
          </tr>
        </thead>
        <tbody>
          <% projects.forEach(p => { %>
          <tr data-name="<%= p.name.toLowerCase() %>">
            <td class="fw-semibold"><%= p.name %></td>
            <td>
              <% if (!p.hasGit) { %>
                <span class="badge text-bg-danger">нет .git</span>
              <% } else if (p.remotes.length === 0) { %>
                <span class="badge text-bg-warning">git, без remote</span>
              <% } else { %>
                <span class="badge text-bg-success">git (<%= p.remotes.length %>)</span>
              <% } %>
            </td>
            <td>
              <% if (p.remotes.length === 0) { %>
                <span class="text-secondary">—</span>
              <% } else { %>
                <% p.remotes.forEach(r => { %>
                  <span
                    class="badge me-1 <%= r.host === 'github' ? 'text-bg-secondary' : r.host === 'gitlab' ? 'text-bg-primary' : 'text-bg-light text-dark' %>"
                    title="<%= r.name %>: <%= r.url %>"
                  >
                    <%= r.host === 'github' ? 'GitHub' : r.host === 'gitlab' ? 'GitLab' : r.name %>
                  </span>
                <% }) %>
              <% } %>
            </td>
            <td>
              <% if (!p.hasGit) { %>
                <span class="text-secondary">—</span>
              <% } else if (p.uncommitted) { %>
                <span class="badge text-bg-danger">● <%= p.uncommittedCount %> изм.</span>
              <% } else { %>
                <span class="badge text-bg-success">чисто</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const filterInput = document.getElementById('filterInput');
    const rows = document.querySelectorAll('#projectsTable tbody tr');
    filterInput.addEventListener('input', () => {
      const q = filterInput.value.trim().toLowerCase();
      rows.forEach((row) => {
        row.style.display = row.dataset.name.includes(q) ? '' : 'none';
      });
    });
  </script>
</body>
</html>
